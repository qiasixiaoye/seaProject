# App ports
APP_PORT=8000
GEO_API_PORT=5001
GEOSERVER_PORT=8081

# LLM
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# RAGFlow.
# If you start RAGFlow with this compose profile, keep the internal service URL.
# If you run RAGFlow outside this compose project, change to http://host.docker.internal:9380.
RAGFLOW_BASE_URL=http://ragflow-cpu:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=

# Local fallback retrieval
OCEAN_EMBEDDING_BACKEND=hash
OCEAN_EMBEDDING_MODEL=local-hash-ngram-v1
OCEAN_EMBEDDING_WEIGHT=0.42

# RAGFlow stack defaults
DOC_ENGINE=elasticsearch
DEVICE=cpu
STACK_VERSION=8.11.3
ELASTIC_PASSWORD=infini_rag_flow
ES_PORT=11200
ES_JAVA_OPTS=-Xms1g -Xmx1g

MYSQL_PASSWORD=infini_rag_flow
MYSQL_DBNAME=rag_flow
EXPOSE_MYSQL_PORT=13306
MYSQL_MAX_PACKET=1073741824

MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow

REDIS_PORT=16379
REDIS_PASSWORD=infini_rag_flow

SVR_WEB_HTTP_PORT=8088
SVR_WEB_HTTPS_PORT=8443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382
GO_HTTP_PORT=9384
GO_ADMIN_PORT=9383

RAGFLOW_IMAGE=infiniflow/ragflow:v0.25.3
TZ=Asia/Shanghai
REGISTER_ENABLED=1
API_PROXY_SCHEME=python
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
